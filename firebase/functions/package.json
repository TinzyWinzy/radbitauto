{
  "name": "vehicle-import-portal-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:emulator": "node --test --test-concurrency=1 \"test/emulator/*.test.ts\"",
    "provision:platform-admin": "node scripts/provision-platform-admin.mjs",
    "build": "esbuild src/index.ts --outfile=lib/index.js --platform=node --format=esm --bundle --packages=external --sourcemap"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "gaxios": "7.3.1"
  }
}
